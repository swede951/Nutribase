    func fetchFoodItems() {
        // Always load local data first to ensure we have something to display
        loadLocalFallbackData()
        
        // Then try to fetch from Supabase
        isLoading = true
        
        // Use a more reliable URL construction
        var urlComponents = URLComponents(string: SupabaseConfig.apiURL)
        urlComponents?.path = "/rest/v1/foods"
        urlComponents?.queryItems = [URLQueryItem(name: "select", value: "*")]
        
        print("Attempting to fetch foods from: \(SupabaseConfig.apiURL)/rest/v1/foods")
        
        guard let url = urlComponents?.url else {
            DispatchQueue.main.async { [weak self] in
                self?.errorMessage = "Invalid URL"
                self?.isLoading = false
            }
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "GET"
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        request.addValue("Bearer \(SupabaseConfig.apiKey)", forHTTPHeaderField: "Authorization")
        request.timeoutInterval = 15
        request.cachePolicy = .reloadIgnoringLocalAndRemoteCacheData
        
        URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
            DispatchQueue.main.async {
                self?.isLoading = false
                
                // Check for network connectivity errors
                if let error = error {
                    print("Supabase API Error: \(error.localizedDescription)")
                    // We already loaded local data, so just log the error
                    return
                }
                
                // Check HTTP status code
                guard let httpResponse = response as? HTTPURLResponse else {
                    print("Invalid HTTP response")
                    return
                }
                
                if !(200...299).contains(httpResponse.statusCode) {
                    print("HTTP Error: \(httpResponse.statusCode)")
                    return
                }
                
                // Check if we have data
                guard let data = data else {
                    print("No data received")
                    return
                }
                
                do {
                    // Print the raw JSON for debugging
                    if let jsonString = String(data: data, encoding: .utf8) {
                        print("Supabase API Response: \(jsonString)")
                    }
                    
                    let decoder = JSONDecoder()
                    // Configure decoder for Supabase date format
                    decoder.dateDecodingStrategy = .iso8601
                    
                    // Try to parse the response
                    let foodItems = try decoder.decode([SupabaseFoodItem].self, from: data)
                    if foodItems.isEmpty {
                        // Successfully parsed but no items
                        print("No food items found in database, using local data")
                    } else {
                        self?.foodItems = foodItems.map { $0.toFoodItem() }
                        self?.errorMessage = nil
                        print("Successfully parsed \(foodItems.count) food items")
                    }
                } catch let decodingError as DecodingError {
                    // Provide detailed information about decoding errors
                    print("Decoding error: \(decodingError)")
                    // We already loaded local data, so just log the error
                } catch {
                    print("JSON Parsing Error: \(error)")
                    // We already loaded local data, so just log the error
                }
            }
        }.resume()
    }
    
    func searchFoodItems(query: String) {
        // Always search local data first to ensure we have something to display
        searchLocalFallbackData(query: query)
        
        // If query is empty, just show local data
        if query.isEmpty {
            DispatchQueue.main.async { [weak self] in
                guard let self = self else { return }
                self.isLoading = false
            }
            return
        }
        
        // Then try to search from Supabase
        isLoading = true
        
        // Construct the URL with query parameters
        guard let encodedQuery = query.addingPercentEncoding(withAllowedCharacters: .urlQueryAllowed) else {
            self.isLoading = false
            self.errorMessage = "Failed to encode search query"
            return
        }
        
        // Use a more reliable URL construction with the correct PostgreSQL LIKE pattern syntax
        var urlComponents = URLComponents(string: SupabaseConfig.apiURL)
        urlComponents?.path = "/rest/v1/foods"
        urlComponents?.queryItems = [
            URLQueryItem(name: "select", value: "*"),
            URLQueryItem(name: "name", value: "ilike.%\(encodedQuery)%")
        ]
        
        print("Searching foods with query: \(query)")
        print("Using URL pattern: \(urlComponents?.url?.absoluteString ?? "invalid URL")")
        print("API Key (first 10 chars): \(String(SupabaseConfig.apiKey.prefix(10)))...")
        print("Full URL components: \(urlComponents?.debugDescription ?? "none")")
        print("Query items: \(urlComponents?.queryItems?.description ?? "none")")
        print("Table name: /rest/v1/foods")
        
        guard let url = urlComponents?.url else {
            DispatchQueue.main.async { [weak self] in
                self?.errorMessage = "Invalid URL"
                self?.isLoading = false
            }
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "GET"
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        request.addValue("Bearer \(SupabaseConfig.apiKey)", forHTTPHeaderField: "Authorization")
        request.timeoutInterval = 15
        request.cachePolicy = .reloadIgnoringLocalAndRemoteCacheData
        
        URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
            DispatchQueue.main.async {
                self?.isLoading = false
                
                // Check for network connectivity errors
                if let error = error {
                    print("Supabase Search Error: \(error.localizedDescription)")
                    // We already searched local data, so just log the error
                    return
                }
                
                // Check HTTP status code
                guard let httpResponse = response as? HTTPURLResponse else {
                    print("Invalid HTTP response")
                    return
                }
                
                if !(200...299).contains(httpResponse.statusCode) {
                    print("HTTP Error: \(httpResponse.statusCode)")
                    return
                }
                
                // Check if we have data
                guard let data = data else {
                    print("No data received")
                    return
                }
                
                do {
                    // Print the raw JSON for debugging
                    if let jsonString = String(data: data, encoding: .utf8) {
                        print("Supabase Search Response: \(jsonString)")
                    }
                    
                    let decoder = JSONDecoder()
                    // Configure decoder for Supabase date format
                    decoder.dateDecodingStrategy = .iso8601
                    
                    // Try to parse the response
                    let foodItems = try decoder.decode([SupabaseFoodItem].self, from: data)
                    if foodItems.isEmpty {
                        // Successfully parsed but no items
                        print("No food items found matching '\(query)', using local data")
                    } else {
                        self?.foodItems = foodItems.map { $0.toFoodItem() }
                        self?.errorMessage = nil
                        print("Successfully parsed \(foodItems.count) food items from search")
                    }
                } catch let decodingError as DecodingError {
                    // Provide detailed information about decoding errors
                    print("Decoding error: \(decodingError)")
                    // We already searched local data, so just log the error
                } catch {
                    print("Search JSON Parsing Error: \(error)")
                    // We already searched local data, so just log the error
                }
            }
        }.resume()
    } // Added closing bracket here
    
    // Load local fallback data when network connection fails
    private func loadLocalFallbackData() {
        DispatchQueue.main.async { [weak self] in
            self?.foodItems = self?.localFoodItems ?? []
        }
    } // Added closing bracket here
    
    // Add a new food item to the Supabase database
    func addFoodItem(_ foodItem: FoodItem, ingredients: [String] = [], completion: @escaping (Bool, String?) -> Void) {
        // Create the nutrients object
        let nutrients = [
            "calories": foodItem.calories,
            "protein": foodItem.protein,
            "carbohydrates": foodItem.carbs,
            "fat": foodItem.fat,
            "serving_size": "100g",
            "servings_per_package": 1.0
        ] as [String : Any]
        
        // Create the food item object for Supabase
        var foodItemData: [String: Any] = [
            "name": foodItem.name,
            "nova_score": foodItem.novaScore,
            "nutrients": nutrients,
            "verified": false,
            "ingredients": ingredients
        ]
        
        // Add brand name and barcode if available
        if let brandName = foodItem.brandName, !brandName.isEmpty {
            foodItemData["brand_name"] = brandName
        }
        
        if let barcode = foodItem.barcode, !barcode.isEmpty {
            foodItemData["barcode"] = barcode
        }
        
        // Convert to JSON data
        guard let jsonData = try? JSONSerialization.data(withJSONObject: foodItemData) else {
            completion(false, "Failed to serialize food data")
            return
        }
        
        // Create URL request
        var urlComponents = URLComponents(string: SupabaseConfig.apiURL)
        urlComponents?.path = "/rest/v1/foods"
        
        guard let url = urlComponents?.url else {
            completion(false, "Invalid URL")
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.httpBody = jsonData
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        request.addValue("Bearer \(SupabaseConfig.apiKey)", forHTTPHeaderField: "Authorization")
        request.addValue("return=representation", forHTTPHeaderField: "Prefer")
        
        // Make the request
        URLSession.shared.dataTask(with: request) { data, response, error in
            DispatchQueue.main.async {
                // Check for network errors
                if let error = error {
                    completion(false, "Network error: \(error.localizedDescription)")
                    return
                }
                
                // Check HTTP status code
                guard let httpResponse = response as? HTTPURLResponse else {
                    completion(false, "Invalid HTTP response")
                    return
                }
                
                if !(200...299).contains(httpResponse.statusCode) {
                    completion(false, "HTTP Error: \(httpResponse.statusCode)")
                    return
                }
                
                // Success!
                // Add the new food item to our local array
                self.foodItems.append(foodItem)
                completion(true, nil)
            }
        }.resume()
    }

    // Search local fallback data when network connection fails
    private func searchLocalFallbackData(query: String) {
        DispatchQueue.main.async { [weak self] in
            guard let self = self else { return }
            
            if query.isEmpty {
                self.foodItems = self.localFoodItems
            } else {
                // Split the query into words for more flexible matching
                let searchTerms = query.lowercased().split(separator: " ").map(String.init)
                
                self.foodItems = self.localFoodItems.filter { food in
                    let foodName = food.name.lowercased()
                    
                    // Check if the entire query is contained in the food name
                    if foodName.contains(query.lowercased()) {
                        return true
                    }
                    
                    // Check if all search terms are found in the food name (in any order)
                    let allTermsFound = searchTerms.allSatisfy { term in
                        foodName.contains(term)
                    }
                    
                    return allTermsFound
                }
            }
        }
    }
    
    // MARK: - Authentication Methods
    
    // Sign up with email and password
    func signUp(email: String, password: String, completion: @escaping (Bool, String?) -> Void) {
        let urlString = "\(SupabaseConfig.apiURL)/auth/v1/signup"
        guard let url = URL(string: urlString) else {
            completion(false, "Invalid URL")
            return
        }
        
        // Create request body
        let body: [String: Any] = [
            "email": email,
            "password": password
        ]
        
        guard let jsonData = try? JSONSerialization.data(withJSONObject: body) else {
            completion(false, "Failed to create request body")
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.httpBody = jsonData
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        
        URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
            guard let self = self else { return }
            
            if let error = error {
                DispatchQueue.main.async {
                    self.authErrorMessage = error.localizedDescription
                    completion(false, error.localizedDescription)
                }
                return
            }
            
            guard let httpResponse = response as? HTTPURLResponse else {
                DispatchQueue.main.async {
                    self.authErrorMessage = "Invalid HTTP response"
                    completion(false, "Invalid HTTP response")
                }
                return
            }
            
            guard let data = data else {
                DispatchQueue.main.async {
                    self.authErrorMessage = "No data received"
                    completion(false, "No data received")
                }
                return
            }
            
            // Check for success response
            if (200...299).contains(httpResponse.statusCode) {
                do {
                    let authResponse = try JSONDecoder().decode(AuthResponse.self, from: data)
                    DispatchQueue.main.async {
                        self.currentUser = authResponse.user
                        self.accessToken = authResponse.access_token
                        self.refreshToken = authResponse.refresh_token
                        self.isAuthenticated = true
                        self.authErrorMessage = nil
                        
                        // Save tokens to UserDefaults
                        UserDefaults.standard.set(authResponse.access_token, forKey: "access_token")
                        UserDefaults.standard.set(authResponse.refresh_token, forKey: "refresh_token")
                        
                        completion(true, nil)
                    }
                } catch {
                    DispatchQueue.main.async {
                        self.authErrorMessage = "Failed to parse response: \(error.localizedDescription)"
                        completion(false, "Failed to parse response: \(error.localizedDescription)")
                    }
                }
            } else {
                // Try to parse error message
                do {
                    let errorResponse = try JSONDecoder().decode(AuthError.self, from: data)
                    DispatchQueue.main.async {
                        self.authErrorMessage = errorResponse.error_description ?? errorResponse.error
                        completion(false, errorResponse.error_description ?? errorResponse.error)
                    }
                } catch {
                    DispatchQueue.main.async {
                        self.authErrorMessage = "HTTP Error: \(httpResponse.statusCode)"
                        completion(false, "HTTP Error: \(httpResponse.statusCode)")
                    }
                }
            }
        }.resume()
    }
    
    // Sign in with email and password
    func signIn(email: String, password: String, completion: @escaping (Bool, String?) -> Void) {
        let urlString = "\(SupabaseConfig.apiURL)/auth/v1/token?grant_type=password"
        guard let url = URL(string: urlString) else {
            completion(false, "Invalid URL")
            return
        }
        
        // Create request body
        let body: [String: Any] = [
            "email": email,
            "password": password
        ]
        
        guard let jsonData = try? JSONSerialization.data(withJSONObject: body) else {
            completion(false, "Failed to create request body")
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.httpBody = jsonData
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        
        URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
            guard let self = self else { return }
            
            if let error = error {
                DispatchQueue.main.async {
                    self.authErrorMessage = error.localizedDescription
                    completion(false, error.localizedDescription)
                }
                return
            }
            
            guard let httpResponse = response as? HTTPURLResponse else {
                DispatchQueue.main.async {
                    self.authErrorMessage = "Invalid HTTP response"
                    completion(false, "Invalid HTTP response")
                }
                return
            }
            
            guard let data = data else {
                DispatchQueue.main.async {
                    self.authErrorMessage = "No data received"
                    completion(false, "No data received")
                }
                return
            }
            
            // Check for success response
            if (200...299).contains(httpResponse.statusCode) {
                do {
                    let authResponse = try JSONDecoder().decode(AuthResponse.self, from: data)
                    DispatchQueue.main.async {
                        self.currentUser = authResponse.user
                        self.accessToken = authResponse.access_token
                        self.refreshToken = authResponse.refresh_token
                        self.isAuthenticated = true
                        self.authErrorMessage = nil
                        
                        // Save tokens to UserDefaults
                        UserDefaults.standard.set(authResponse.access_token, forKey: "access_token")
                        UserDefaults.standard.set(authResponse.refresh_token, forKey: "refresh_token")
                        
                        completion(true, nil)
                    }
                } catch {
                    DispatchQueue.main.async {
                        self.authErrorMessage = "Failed to parse response: \(error.localizedDescription)"
                        completion(false, "Failed to parse response: \(error.localizedDescription)")
                    }
                }
            } else {
                // Try to parse error message
                do {
                    let errorResponse = try JSONDecoder().decode(AuthError.self, from: data)
                    DispatchQueue.main.async {
                        self.authErrorMessage = errorResponse.error_description ?? errorResponse.error
                        completion(false, errorResponse.error_description ?? errorResponse.error)
                    }
                } catch {
                    DispatchQueue.main.async {
                        self.authErrorMessage = "HTTP Error: \(httpResponse.statusCode)"
                        completion(false, "HTTP Error: \(httpResponse.statusCode)")
                    }
                }
            }
        }.resume()
    }
    
    // Sign out the current user
    func signOut(completion: @escaping (Bool, String?) -> Void) {
        guard let accessToken = self.accessToken else {
            // Already signed out
            DispatchQueue.main.async {
                self.currentUser = nil
                self.accessToken = nil
                self.refreshToken = nil
                self.isAuthenticated = false
                
                // Clear tokens from UserDefaults
                UserDefaults.standard.removeObject(forKey: "access_token")
                UserDefaults.standard.removeObject(forKey: "refresh_token")
                
                completion(true, nil)
            }
            return
        }
        
        let urlString = "\(SupabaseConfig.apiURL)/auth/v1/logout"
        guard let url = URL(string: urlString) else {
            completion(false, "Invalid URL")
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        request.addValue("Bearer \(accessToken)", forHTTPHeaderField: "Authorization")
        
        URLSession.shared.dataTask(with: request) { [weak self] _, response, error in
            guard let self = self else { return }
            
            DispatchQueue.main.async {
                // Reset auth state regardless of response
                self.currentUser = nil
                self.accessToken = nil
                self.refreshToken = nil
                self.isAuthenticated = false
                
                // Clear tokens from UserDefaults
                UserDefaults.standard.removeObject(forKey: "access_token")
                UserDefaults.standard.removeObject(forKey: "refresh_token")
                
                if let error = error {
                    self.authErrorMessage = error.localizedDescription
                    completion(false, error.localizedDescription)
                    return
                }
                
                guard let httpResponse = response as? HTTPURLResponse else {
                    self.authErrorMessage = "Invalid HTTP response"
                    completion(false, "Invalid HTTP response")
                    return
                }
                
                if (200...299).contains(httpResponse.statusCode) {
                    self.authErrorMessage = nil
                    completion(true, nil)
                } else {
                    self.authErrorMessage = "HTTP Error: \(httpResponse.statusCode)"
                    completion(false, "HTTP Error: \(httpResponse.statusCode)")
                }
            }
        }.resume()
    }
    
    // Check if user is already authenticated (from saved tokens)
    func checkAuthentication(completion: ((Bool, String?) -> Void)? = nil) {
        if let savedAccessToken = UserDefaults.standard.string(forKey: "access_token"),
           let savedRefreshToken = UserDefaults.standard.string(forKey: "refresh_token") {
            // We have saved tokens, validate them by getting user
            self.accessToken = savedAccessToken
            self.refreshToken = savedRefreshToken
            getUserProfile { success, error in
                // If validation fails, tokens might be expired
                if !success {
                    self.refreshSession { refreshSuccess, refreshError in
                        DispatchQueue.main.async {
                            self.isAuthenticated = refreshSuccess
                            completion?(refreshSuccess, refreshError)
                        }
                    }
                } else {
                    DispatchQueue.main.async {
                        self.isAuthenticated = true
                        completion?(true, nil)
                    }
                }
            }
        } else {
            DispatchQueue.main.async {
                self.isAuthenticated = false
                completion?(false, "No saved authentication tokens")
            }
        }
    }
    
    // Get current user profile
    func getUserProfile(completion: @escaping (Bool, String?) -> Void) {
        guard let accessToken = self.accessToken else {
            completion(false, "Not authenticated")
            return
        }
        
        let urlString = "\(SupabaseConfig.apiURL)/auth/v1/user"
        guard let url = URL(string: urlString) else {
            completion(false, "Invalid URL")
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "GET"
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        request.addValue("Bearer \(accessToken)", forHTTPHeaderField: "Authorization")
        
        URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
            guard let self = self else { return }
            
            if let error = error {
                DispatchQueue.main.async {
                    self.authErrorMessage = error.localizedDescription
                    completion(false, error.localizedDescription)
                }
                return
            }
            
            guard let httpResponse = response as? HTTPURLResponse else {
                DispatchQueue.main.async {
                    self.authErrorMessage = "Invalid HTTP response"
                    completion(false, "Invalid HTTP response")
                }
                return
            }
            
            guard let data = data else {
                DispatchQueue.main.async {
                    self.authErrorMessage = "No data received"
                    completion(false, "No data received")
                }
                return
            }
            
            if (200...299).contains(httpResponse.statusCode) {
                do {
                    let user = try JSONDecoder().decode(AuthUser.self, from: data)
                    DispatchQueue.main.async {
                        self.currentUser = user
                        self.isAuthenticated = true
                        self.authErrorMessage = nil
                        completion(true, nil)
                    }
                } catch {
                    DispatchQueue.main.async {
                        self.authErrorMessage = "Failed to parse user data"
                        completion(false, "Failed to parse user data")
                    }
                }
            } else {
                DispatchQueue.main.async {
                    self.authErrorMessage = "HTTP Error: \(httpResponse.statusCode)"
                    completion(false, "HTTP Error: \(httpResponse.statusCode)")
                }
            }
        }.resume()
    }
    
    // Refresh session with refresh token
    private func refreshSession(completion: @escaping (Bool, String?) -> Void) {
        guard let refreshToken = self.refreshToken else {
            // No refresh token available
            DispatchQueue.main.async {
                self.currentUser = nil
                self.accessToken = nil
                self.refreshToken = nil
                self.isAuthenticated = false
                
                // Clear tokens from UserDefaults
                UserDefaults.standard.removeObject(forKey: "access_token")
                UserDefaults.standard.removeObject(forKey: "refresh_token")
                
                completion(false, "No refresh token available")
            }
            return
        }
        
        let urlString = "\(SupabaseConfig.apiURL)/auth/v1/token?grant_type=refresh_token"
        guard let url = URL(string: urlString) else { return }
        
        // Create request body
        let body: [String: Any] = [
            "refresh_token": refreshToken
        ]
        
        guard let jsonData = try? JSONSerialization.data(withJSONObject: body) else { return }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.httpBody = jsonData
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        
        URLSession.shared.dataTask(with: request) { [weak self] data, response, error in
            guard let self = self else { return }
            
            if let error = error {
                print("Refresh token error: \(error.localizedDescription)")
                self.handleRefreshFailure()
                completion(false, "Refresh token error: \(error.localizedDescription)")
                return
            }
            
            guard let httpResponse = response as? HTTPURLResponse,
                  (200...299).contains(httpResponse.statusCode),
                  let data = data else {
                print("Refresh token HTTP error")
                self.handleRefreshFailure()
                completion(false, "Refresh token HTTP error: \(httpResponse?.statusCode ?? 0)")
                return
            }
            
            do {
                let authResponse = try JSONDecoder().decode(AuthResponse.self, from: data)
                DispatchQueue.main.async {
                    self.currentUser = authResponse.user
                    self.accessToken = authResponse.access_token
                    self.refreshToken = authResponse.refresh_token
                    self.isAuthenticated = true
                    
                    // Save new tokens to UserDefaults
                    UserDefaults.standard.set(authResponse.access_token, forKey: "access_token")
                    UserDefaults.standard.set(authResponse.refresh_token, forKey: "refresh_token")
                    
                    completion(true, nil)
                }
            } catch {
                print("Failed to parse refresh token response: \(error.localizedDescription)")
                self.handleRefreshFailure()
                completion(false, "Failed to parse refresh token response: \(error.localizedDescription)")
            }
        }.resume()
    }
    
    // Handle refresh token failure
    private func handleRefreshFailure() {
        DispatchQueue.main.async {
            self.currentUser = nil
            self.accessToken = nil
            self.refreshToken = nil
            self.isAuthenticated = false
            
            // Clear tokens from UserDefaults
            UserDefaults.standard.removeObject(forKey: "access_token")
            UserDefaults.standard.removeObject(forKey: "refresh_token")
        }
    }
    
    // Search for food items by ID or other criteria
    func searchFoodItemsById(id: String, completion: @escaping ([FoodItem]?, String?) -> Void) {
        // Construct the URL with query parameters
        var urlComponents = URLComponents(string: SupabaseConfig.apiURL)
        urlComponents?.path = "/rest/v1/foods"
        urlComponents?.queryItems = [
            URLQueryItem(name: "select", value: "*"),
            URLQueryItem(name: "id", value: "eq."+id)
        ]
        
        guard let url = urlComponents?.url else {
            completion(nil, "Invalid URL")
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "GET"
        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
        request.addValue(SupabaseConfig.apiKey, forHTTPHeaderField: "apikey")
        request.addValue("Bearer \(accessToken ?? SupabaseConfig.apiKey)", forHTTPHeaderField: "Authorization")
        request.timeoutInterval = 15
        request.cachePolicy = .reloadIgnoringLocalAndRemoteCacheData
        
        URLSession.shared.dataTask(with: request) { data, response, error in
            // Check for network connectivity errors
            if let error = error {
                print("Foods Search Error: \(error.localizedDescription)")
                completion(nil, error.localizedDescription)
                return
            }
            
            // Check HTTP status code
            guard let httpResponse = response as? HTTPURLResponse else {
                print("Invalid HTTP response")
                completion(nil, "Invalid HTTP response")
                return
            }
            
            if !(200...299).contains(httpResponse.statusCode) {
                print("HTTP Error: \(httpResponse.statusCode)")
                completion(nil, "HTTP Error: \(httpResponse.statusCode)")
                return
            }
            
            // Check if we have data
            guard let data = data else {
                print("No data received")
                completion(nil, "No data received")
                return
            }
            
            do {
                // Print the raw JSON for debugging
                if let jsonString = String(data: data, encoding: .utf8) {
                    print("Foods Search Response: \(jsonString)")
                }
                
                let decoder = JSONDecoder()
                decoder.dateDecodingStrategy = .iso8601
                
                // Try to parse the response
                let foodItems = try decoder.decode([SupabaseFoodItem].self, from: data)
                let foods = foodItems.map { $0.toFoodItem() }
                completion(foods, nil)
            } catch {
                print("Foods Search JSON Parsing Error: \(error)")
                completion(nil, "Error parsing food data")
            }
        }.resume()
    }
    
    // Get user's favorite foods
    func getFavoriteFoods(completion: @escaping ([FoodItem]?, String?) -> Void) {
        guard isAuthenticated, let userId = currentUser?.id else {
            completion(nil, "Not authenticated")
            return
